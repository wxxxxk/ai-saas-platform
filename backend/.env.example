# AI SaaS Platform — Backend local development
#
# backend 디렉터리에서 다음 명령으로 생성:
# cp .env.example .env
#
# 기본 dev 프로필은 로컬 H2 DB를 사용하므로
# DB_URL, DB_USERNAME, DB_PASSWORD는 필요하지 않다.

SPRING_PROFILES_ACTIVE=dev

# 선택 사항: 미설정 상태에서도 서버는 실행 가능
OPENAI_API_KEY=

# 로컬 개발용 32자 이상의 값
# 운영 환경에서는 반드시 별도의 강력한 비밀값 사용
JWT_SECRET=dev-only-change-this-jwt-secret-32-bytes

# 선택 사항: 미설정 시 이미지 영구 저장 대신 공급자 URL 사용
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=images
